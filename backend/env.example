# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Configure LLM model
# LLM_MODEL=gpt-3.5-turbo
# LLM_MODEL=gpt-4

# ChromaDB Configuration
# Path where ChromaDB will store vector data (defaults to ./chroma_db)
# For production, use an absolute path to a persistent volume
# CHROMA_DB_PATH=/app/data/chroma_db

# PDF to HTML Conversion
# Use Docker to run pdf2htmlEX (set to "true" if pdf2htmlEX is not installed locally)
# PDF2HTMLEX_USE_DOCKER=false


